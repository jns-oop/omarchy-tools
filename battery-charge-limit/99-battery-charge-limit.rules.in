# Keep @BATTERY@ limited at boot and let group @GROUP@ change the threshold
# without a password: battery-charge-limit [toggle|on|off|status]
SUBSYSTEM=="power_supply", KERNEL=="@BATTERY@", ACTION=="add", ATTR{charge_control_end_threshold}="80", RUN+="/usr/bin/chgrp @GROUP@ /sys/class/power_supply/@BATTERY@/charge_control_end_threshold", RUN+="/usr/bin/chmod 0664 /sys/class/power_supply/@BATTERY@/charge_control_end_threshold"
