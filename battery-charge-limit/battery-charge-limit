#!/usr/bin/env bash

# Limit a laptop battery's charge threshold and toggle the limit on demand.
#
#   battery-charge-limit          toggle between the limit and 100%
#   battery-charge-limit on       stop charging at the limit
#   battery-charge-limit off      charge to 100%
#   battery-charge-limit status   print the current limit
#
# The battery is detected by its charge_control_end_threshold attribute, so
# BAT0, BAT1, CMB0 and friends all work; set BATTERY=/sys/class/power_supply/...
# to pick one explicitly. CHARGE_LIMIT overrides the 80% default.
#
# Writing the limit needs root. The udev rule in
# /etc/udev/rules.d/99-battery-charge-limit.rules grants an admin group write
# access, so the toggle needs no password; pkexec is only a fallback.

set -euo pipefail

LIMIT="${CHARGE_LIMIT:-80}"
FULL=100

detect_battery() {
  local dir
  for dir in /sys/class/power_supply/*; do
    [[ -e $dir/charge_control_end_threshold ]] || continue
    printf '%s\n' "$dir"
    return 0
  done
  return 1
}

BAT="${BATTERY:-$(detect_battery || true)}"
BAT="${BAT%/}"
if [[ -z $BAT ]]; then
  echo "No battery with charge_control_end_threshold found under /sys/class/power_supply" >&2
  exit 1
fi
ATTR="$BAT/charge_control_end_threshold"

if [[ ! -e $ATTR ]]; then
  echo "No charge threshold control at $ATTR" >&2
  exit 1
fi

if [[ ! -w $ATTR ]] && (( EUID != 0 )); then
  # pkexec starts with a clean environment, so the battery and limit have to be
  # passed explicitly or an override would be silently dropped.
  if command -v pkexec >/dev/null 2>&1; then
    exec pkexec --user root env BATTERY="$BAT" CHARGE_LIMIT="$LIMIT" \
      "$(readlink -f -- "$0")" "$@"
  fi
  echo "Need root to write $ATTR (install the udev rule, or run with sudo)" >&2
  exit 1
fi

current=$(cat "$ATTR")

notify() {
  omarchy-notification-send -g 󰂑 -u low -t 3000 "Battery" "$1" >/dev/null 2>&1 || true
}

set_limit() {
  printf '%s\n' "$1" >"$ATTR"

  if (( $1 >= FULL )); then
    notify "Charging to 100%"
  else
    notify "Charging limited to $1%"
  fi
}

case "${1:-toggle}" in
  toggle)
    if (( current <= LIMIT )); then
      set_limit "$FULL"
    else
      set_limit "$LIMIT"
    fi
    ;;
  on) set_limit "$LIMIT" ;;
  off) set_limit "$FULL" ;;
  status)
    printf '%s: limit %s%%  capacity %s%%  %s\n' \
      "${BAT##*/}" "$current" "$(cat "$BAT/capacity")" "$(cat "$BAT/status")"
    ;;
  *)
    echo "Usage: battery-charge-limit [toggle|on|off|status]" >&2
    exit 2
    ;;
esac
